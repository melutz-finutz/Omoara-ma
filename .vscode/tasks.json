{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "hello_world.cpp",
                "-o",
                "output/hello_world.exe"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": ".\\output\\hello_world.exe",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "dependsOn": "Compile"
        },
        {
            "label": "Compile & run",
            "dependsOn": [
                "Compile",
                "Run"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}